{
    "geode": "5.4.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "cubicstudios.horriblemenu",
    "name": "Horrible Menu",
    "version": "1.2.6",
    "developers": [
        "Team Breakeode",
        "Cheeseworks"
    ],
    "description": "A plethora of ways to ruin your experience...",
    "links": {
        "source": "https://github.com/CubicCommunity/HorribleMenu",
        "homepage": "https://breakeode.cubicstudios.xyz/",
        "community": "https://www.dsc.gg/cubic"
    },
    "tags": [
        "joke",
        "cheat",
        "offline",
        "universal",
        "gameplay",
        "content"
    ],
    "resources": {
        "spritesheets": {
            "BRKD_HM_icons": [
                "resources/*.png"
            ]
        }
    },
    "api": {
        "include": [
            "include/horrible/*.h*"
        ]
    },
    "dependencies": {
        "cheeseworks.moddevbranding": {
            "version": ">=2.0.0",
            "required": false
        }
    },
    "settings": {
        "btn-popup": {
            "type": "button",
            "name": "Menu Button",
            "buttons": {
                "menu": "Horrible Options Menu"
            },
            "description": "Open the <cg>Horrible Options</c> menu."
        },
        "key-popup": {
            "type": "keybind",
            "name": "Options Menu",
            "description": "Keybind to open the <cg>Horrible Options</c> menu.",
            "default": [
                "\\"
            ],
            "category": "universal"
        },
        "safe-mode-section": {
            "type": "title",
            "name": "Safe Mode",
            "description": "Settings for Safe Mode."
        },
        "safe-mode-info": {
            "type": "info",
            "description": "Safe Mode prevents you from accidentally saving progress in levels while using this mod's features.",
            "color": "#00FF00"
        },
        "safe-mode": {
            "type": "bool",
            "name": "Enable",
            "description": "Prevent accidentally saving progress made in levels while using this mod's features. <co>We recommend keeping this enabled while this mod is active!</cr>",
            "default": true,
            "enable-if": "!dyn-safe-mode",
            "enable-if-description": "Disable Automatic Safe Mode to manually change this setting."
        },
        "dyn-safe-mode": {
            "type": "bool",
            "name": "Automatic",
            "description": "Automatically toggle Safe Mode whenever you toggle any options that are marked as cheats.",
            "default": true
        },
        "utils": {
            "type": "button",
            "name": "Disable All Cheats",
            "buttons": {
                "copy-list": "Copy Enabled Options",
                "disable-cheats": "Disable Cheats"
            },
            "description": "Quickly disable every option that is <cr>marked as cheating</c>. <cg>Feel free to do this if *Automatic Safe Mode* is enabled and you're not sure what's triggering it.</c>\n\n> ![**(i)**](frame:GJ_infoIcon_001.png?scale=0.425) <cj>*Before reaching support, be sure to keep a copy of your currently enabled options list.*</c>"
        },
        "ui": {
            "type": "title",
            "name": "Interface",
            "description": "Appearance and functionality of the interface."
        },
        "hide-if-offline": {
            "type": "bool",
            "name": "Conditionally Show Online Options",
            "description": "Hide options from the list that require an internet connection to work, while you're offline.",
            "default": true
        },
        "theme": {
            "type": "string",
            "name": "Menu Theme",
            "description": "Theme to use for the <cg>Horrible Options</c> menu interface. <co>Texture packs are not supported.</c>",
            "default": "Default",
            "one-of": [
                "Default",
                "Icy",
                "Grass",
                "Dark",
                "Light",
                "Dim",
                "Girlypop",
                "Aqua",
                "Geode"
            ]
        },
        "theme-background": {
            "type": "file",
            "name": "Menu Theme Background",
            "description": "Local image file to use as a semi-transparent background image for the <cg>Horrible Options</c> menu interface. <co>Selected image will be stretched to fit the menu window's size.</c>\n\n> ![**(o)**](frame:collaborationIcon_001.png?scale=0.95) <cg>*To load animated images, first install [ImagePlus](mod:prevter.imageplus).*</c>\n\n<mod:prevter.imageplus>",
            "default": "",
            "control": {
                "dialog": "open",
                "filters": [
                    {
                        "files": [
                            "*.png",
                            "*.jpg",
                            "*.jpeg",
                            "*.webp",
                            "*.apng",
                            "*.gif",
                            "*.qoi",
                            "*.jxl"
                        ],
                        "description": "Image Files"
                    }
                ]
            }
        },
        "floating-btn-section": {
            "type": "title",
            "name": "Floating Button",
            "description": "Configure the floating menu button, intended for touchscreen users to easily access the <cg>Horrible Options</c> menu."
        },
        "floating-btn": {
            "type": "bool",
            "name": "Enable Floating Button",
            "description": "Show the floating button to quickly open the <cg>Horrible Options</c> menu.",
            "default": {
                "win": false,
                "mac": false,
                "android": true,
                "ios": true
            }
        },
        "floating-btn-icon": {
            "type": "string",
            "name": "Button Icon",
            "description": "Show an icon on the floating button.",
            "default": "Default",
            "one-of": [
                "Default",
                "Classic",
                "Pride",
                "Trans Pride",
                "Breakeode",
                "Crying Skull",
                "The Yellow One",
                ":3",
                "durr",
                "Sapphire SDK"
            ],
            "enable-if": "floating-btn"
        },
        "floating-btn-level": {
            "type": "bool",
            "name": "Show in Level",
            "description": "Show the floating menu button while playing a level.",
            "default": false,
            "enable-if": "floating-btn"
        },
        "floating-btn-editor": {
            "type": "bool",
            "name": "Show in Editor",
            "description": "Show the floating menu button while editing a level.",
            "default": false,
            "enable-if": "floating-btn"
        },
        "floating-btn-scale": {
            "type": "float",
            "name": "Button Scale",
            "description": "Change the size of the floating button.",
            "default": 1.0,
            "min": 0.5,
            "max": 2.5,
            "control": {
                "input": true,
                "slider": true,
                "slider-step": 0.1,
                "arrows": true,
                "arrow-step": 0.1,
                "big-arrows": true,
                "big-arrow-step": 0.5
            },
            "enable-if": "floating-btn"
        },
        "floating-btn-opacity": {
            "type": "int",
            "name": "Button Opacity",
